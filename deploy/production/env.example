# /opt/cipherdrop/.env — host settings (root, 0600). install.sh writes it and
# keeps your edits on re-runs (it only updates the keys you pass as options).
# After editing: sudo cipherdropctl restart

# Public hostname served by your reverse proxy.
CIPHERDROP_DOMAIN=paste.example.com

# Loopback port your reverse proxy forwards to (http://127.0.0.1:PORT).
CIPHERDROP_PORT=8080

# Docker network for the container (chosen by install.sh to avoid overlaps).
CIPHERDROP_SUBNET=172.30.0.0/24
CIPHERDROP_GATEWAY=172.30.0.1
# Peers allowed to set X-Forwarded-For / X-Forwarded-Proto (JSON list).
CIPHERDROP_TRUSTED_PROXIES='["172.30.0.1/32"]'

# Name of the Docker network of a containerised reverse proxy (empty: proxy runs on the host).
CIPHERDROP_PROXY_NETWORK=

# true: SQLite-backed persistent shares (compose.persistent.yml).
CIPHERDROP_PERSISTENT=false

# Releases come from this repository (owner/name), via the deploy key and token in /etc/cipherdrop.
CIPHERDROP_GITHUB_REPO=OWNER/CipherDrop

# Automatic updates: true or false. "stable" ignores pre-release tags (vX.Y.Z-rc.N);
# "prerelease" deploys them too.
CIPHERDROP_AUTO_UPDATE=true
CIPHERDROP_CHANNEL=stable
# Also update cipherdropctl, the smoke test and the systemd units from each release.
CIPHERDROP_AUTO_UPDATE_TOOLS=true

# Optional: POST a message here on deploys and failures (ntfy.sh topic URL,
# Slack or Discord incoming webhook, or any URL accepting a text body).
CIPHERDROP_NOTIFY_URL=

# Resource limits. Keep CIPHERDROP_MAX_MEMORY_MB well below CIPHERDROP_MEM_LIMIT.
CIPHERDROP_MEM_LIMIT=256m
CIPHERDROP_CPUS=1.0
CIPHERDROP_MAX_MEMORY_MB=128
