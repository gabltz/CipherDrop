# /opt/cipherdrop/config.toml — mounted read-only into the container.
# Owned root:65532, mode 0640. install.sh creates it from this template on
# first run and never overwrites it afterwards.
#
# server.public_url, listen address, proxy trust, memory limit and logging are
# set by compose.yml from .env and override anything here. cipherdropctl
# appends a "cipherdrop-smoke" token (shares:create) used by post-deploy checks.
# Full reference: docs/configuration.md and config.example.toml.
#
# After editing:  sudo cipherdropctl check-config && sudo cipherdropctl restart

[server]
public_url = "https://paste.example.com"   # overridden by CIPHERDROP_DOMAIN
max_concurrent_requests = 256
max_concurrent_requests_per_ip = 32
max_connections = 4096
max_connections_per_ip = 64

[storage]
default_backend = "memory"
max_shares = 10000
reject_when_full = true

[shares]
max_size_bytes = 1048576
default_ttl_seconds = 3600
max_ttl_seconds = 604800
default_max_reads = 1
max_reads = 100
allow_permanent = false
allow_unlimited_reads = false
max_access_failures = 10

[auth]
# Anonymous creation is off: senders need an API token. Set to true for a
# public pastebin (rate limits below then apply per IP).
anonymous_creation = false
anonymous_retrieval = true

# Add tokens with:  sudo cipherdropctl token add alice            (scope shares:create)
#                   sudo cipherdropctl token add ci shares:create shares:revoke
# The token is printed once; its verifier block is appended below, like:
#
# [[auth.tokens]]
# id = "4f1c2a9b7e30"
# name = "alice"
# sha256 = "<64 hex chars>"
# scopes = ["shares:create"]

[rate_limit]
enabled = true
create_per_minute = 30
read_per_minute = 120
token_default_per_minute = 600

[metrics]
enabled = false
require_token = true
