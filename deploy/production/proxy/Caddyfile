# CipherDrop behind Caddy — generated by install.sh for __DOMAIN__.
# Add this site block to your Caddyfile, then: caddy reload (or systemctl reload caddy).
# Caddy obtains the certificate, redirects HTTP to HTTPS and sets
# X-Forwarded-For/-Proto itself. Leave access logging off for this site
# (no `log` directive): URLs contain share ids.

__DOMAIN__ {
	request_body {
		max_size 2MB
	}
	reverse_proxy __UPSTREAM__ {
		flush_interval -1
	}
}
